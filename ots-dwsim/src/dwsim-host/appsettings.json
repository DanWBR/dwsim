{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "DWSIM.OTS": "Debug"
    }
  },
  "AllowedHosts": "*",
  "FlowsheetPath": "./data/flowsheets",
  "SnapshotPath": "./data/snapshots",
  "ScenarioPath": "./data/scenarios",
  "ScenarioSchemaPath": "./schemas/scenario.schema.json",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=ots_dwsim;Username=ots_user;Password=ots_password",
    "TimescaleDB": "Host=localhost;Port=5433;Database=ots_timeseries;Username=ots_user;Password=ots_password"
  },
  "TimeSeriesLogging": {
    "PollingIntervalMs": 1000,
    "BatchSize": 100,
    "Enabled": true
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5000"
      }
    }
  }
}
